// HUD history: per cell, how consistently the live depth has been at the maximum over the last
// second or so. A HUD stays put; bullet impacts and flashes drawn at the maximum come and go.

#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 16, local_size_y = 16) in;

#include "depth_common.glsl"

// Rises over about a second while the maximum is there, fades over about ten once it is gone, so a
// HUD element that is redrawn (the ammo row as shots are fired) does not flicker in and out.
const float RISE = 1.0 / 30.0;
const float FADE = 1.0 / 600.0;

void main()
{
	const ivec2 cell = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(cell, params.out_size)))
		return;
	const float h = imageLoad(hud_history, cell).r;
	const bool at_max = IsLiveMax(cell);
	imageStore(hud_history, cell, vec4(at_max ? mix(h, 1.0, RISE) : mix(h, 0.0, FADE)));
}
