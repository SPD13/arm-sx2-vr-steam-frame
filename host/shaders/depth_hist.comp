// Histogram of the valid depth over [zmin, zmax] (from depth_stats), for the percentile range.

#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 16, local_size_y = 16) in;

#include "depth_common.glsl"

shared uint group_bins[256];

void main()
{
	group_bins[gl_LocalInvocationIndex] = 0u;
	barrier();

	const ivec2 cell = ivec2(gl_GlobalInvocationID.xy);
	if (all(lessThan(cell, params.out_size)) && stats.valid > 0u)
	{
		const float z = SampleDepth(cell);
		if (IsSceneDepth(z))
		{
			const float zmin = uintBitsToFloat(stats.zmin);
			const float zmax = uintBitsToFloat(stats.zmax);
			const float t = (z - zmin) / max(zmax - zmin, 1e-7);
			atomicAdd(group_bins[min(uint(t * 256.0), 255u)], 1u);
		}
	}
	barrier();

	const uint count = group_bins[gl_LocalInvocationIndex];
	if (count > 0u)
		atomicAdd(histogram.bins[gl_LocalInvocationIndex], count);
}
