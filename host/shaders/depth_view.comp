// Debug view of the normalised depth: a colour ramp (near = warm, far = cool), cells without depth
// in a dark checker so holes stand out, and HUD cells (pinned to the screen plane) in white.

#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 16, local_size_y = 16) in;

#include "depth_common.glsl"

layout(set = 0, binding = 2, rgba8) uniform writeonly image2D out_image;

// Polynomial fit of the Turbo colour map (Google, Apache-2.0).
vec3 Turbo(float x)
{
	const vec4 kr4 = vec4(0.13572138, 4.61539260, -42.66032258, 132.13108234);
	const vec4 kg4 = vec4(0.09140261, 2.19418839, 4.84296658, -14.18503333);
	const vec4 kb4 = vec4(0.10667330, 12.64194608, -60.58204836, 110.36276771);
	const vec2 kr2 = vec2(-152.94239396, 59.28637943);
	const vec2 kg2 = vec2(4.27729857, 2.82956604);
	const vec2 kb2 = vec2(-89.90310912, 27.34824973);
	x = clamp(x, 0.0, 1.0);
	const vec4 v4 = vec4(1.0, x, x * x, x * x * x);
	const vec2 v2 = v4.zw * v4.z;
	return vec3(dot(v4, kr4) + dot(v2, kr2), dot(v4, kg4) + dot(v2, kg2), dot(v4, kb4) + dot(v2, kb2));
}

void main()
{
	const ivec2 cell = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(cell, params.out_size)))
		return;

	// The normalised depth the window uses, so the panel shows what the 3D view gets.
	vec3 colour;
	if (IsHud(cell))
		colour = vec3(1.0);
	else if (SampleDepth(cell) > 0.0 && range.initialized != 0u)
		colour = Turbo(NormalizedDepth(cell));
	else
	{
		const bool odd = (((cell.x >> 3) ^ (cell.y >> 3)) & 1) != 0;
		colour = odd ? vec3(0.12, 0.02, 0.16) : vec3(0.06, 0.0, 0.08);
	}
	imageStore(out_image, cell, vec4(colour, 1.0));
}
